# 브라우저에 들어가는 값. 배포 빌드 전에 넣어야 반영된다.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_EXTENDED_NETWORK=testnet
NEXT_PUBLIC_EXTENDED_BUILDER_ID=

# 서버에서만 읽는다. 정산 API(/api/builder/trades)용.
EXTENDED_BUILDER_API_KEY=
BUILDER_ADMIN_TOKEN=

# 테스트넷 호가 봇(npm run maker:testnet) 전용 EVM 개인키. 사용자·빌더 지갑과 다른 지갑을 쓴다.
TESTNET_MAKER_PRIVATE_KEY=
# 선택: 마켓 목록, 단계 수, 간격(비율), 갱신 주기
# TESTNET_MAKER_MARKETS=BTC-USD,ETH-USD,SOL-USD
# TESTNET_MAKER_LEVELS=5
# TESTNET_MAKER_SPREAD=0.0005
# TESTNET_MAKER_STEP=0.0005
# TESTNET_MAKER_REFRESH_MS=15000
